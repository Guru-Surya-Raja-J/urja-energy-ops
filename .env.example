# Copy to .env and adjust. All values except the credentials have sensible defaults.

# Portal access (from the take-home brief)
PORTAL_URL=https://urja-ops.flockenergy.tech
PORTAL_EMAIL=operator@urja.local
PORTAL_PASSWORD=urja-ops-2026

# MongoDB (local install, or `docker compose up -d mongo`)
MONGODB_URI=mongodb://127.0.0.1:27017/urja_meter_api

PORT=4000

# The portal returns 429 at ~120 requests/minute; stay under it.
PORTAL_REQUESTS_PER_MINUTE=100
PORTAL_TIMEOUT_MS=15000

# Freshness: re-sync the meter catalogue after 10 min; re-fetch a reading window after 5 min.
CATALOG_TTL_SECONDS=600
READINGS_TTL_SECONDS=300

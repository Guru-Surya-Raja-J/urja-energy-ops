    "/api/v1/meters/{meterId}/readings": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "Raw register readings for a date window",
        "description": "Cumulative kWh/kVAh registers and R-phase voltage, as numbers, with IST timestamps. Duplicate/blank portal rows are dropped and listed in `dropped`.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "J100004"
            },
            "required": true,
            "name": "meterId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "First day (inclusive, IST). Alone: a 7-day window starting here.",
              "example": "2026-06-01"
            },
            "required": false,
            "description": "First day (inclusive, IST). Alone: a 7-day window starting here.",
            "name": "from",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Last day (inclusive, IST). Alone: a 7-day window ending here. Neither: the latest 7 days.",
              "example": "2026-06-30"
            },
            "required": false,
            "description": "Last day (inclusive, IST). Alone: a 7-day window ending here. Neither: the latest 7 days.",
            "name": "to",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Readings, oldest first.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadingsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad date window.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Unknown meter.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "502": {
            "description": "The portal returned something unexpected.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "The portal is unreachable or kept rate-limiting us.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
